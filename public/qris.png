  <!-- Center Logo Badge -->
  <rect x="115" y="115" width="70" height="70" rx="14" fill="#0F172A" stroke="#DC2626" stroke-width="3"/>
  <circle cx="150" cy="150" r="24" fill="#DC2626"/>
  <text x="150" y="156" font-family="Arial, sans-serif" font-size="16" font-weight="900" text-anchor="middle" fill="#FFFFFF">CS</text>

  <!-- Footer Brands -->
  <rect x="20" y="265" width="260" height="24" rx="6" fill="#F1F5F9"/>
  <text x="150" y="281" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle" fill="#475569">BCA • MANDIRI • BRI • DANA • GOPAY • OVO • SHOPEEPAY</text>
